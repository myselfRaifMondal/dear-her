  | "cloud_magic_link_sent"
  | "cloud_signed_out"
  | "cloud_backup_saved"
  | "cloud_backup_checked"
  | "cloud_backup_restored"
  | "cloud_backup_deleted"
  | "mira_ai_reply_success"
  | "mira_ai_reply_fallback"
  | "mira_ai_reply_error"
  | "feedback_submitted"
  | "care_package_created"
  | "care_package_copied"
  | "care_package_opened"
  | "landing_cta_clicked"
  | "onboarding_started"
  | "onboarding_completed"
  | "first_session_guide_started"
  | "first_session_guide_dismissed"
  | "beta_badge_clicked"
  | "testimonial_placeholder_clicked"
  | "waitlist_submitted"
  | "waitlist_failed"
  | "waitlist_invite_copied"
