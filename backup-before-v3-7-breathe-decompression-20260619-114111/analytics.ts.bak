  | "v3_revamp_loaded"
  | "daily_plan_started"
  | "daily_plan_step_opened"
  | "daily_plan_step_completed"
  | "daily_plan_intention_updated"
  | "daily_plan_energy_updated"
  | "daily_plan_reset"
  | "you_space_tab_changed"
  | "you_space_export_clicked"
  | "you_space_privacy_action"
  | "you_space_quick_action"
  | "you_space_beta_action"
  | "care_package_template_selected"
  | "care_package_preview_toggled"
  | "care_package_share_clicked"
  | "care_package_viewer_action_clicked"
  | "care_package_note_refined"
