# Dear Her Supabase setup
# Create a Supabase project, then paste these values from:
# Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# Dear Her Mira AI companion
# Server-side only. Do not prefix with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Founder/testing mode
# Used only to unlock /feedback and /insights in the browser.
VITE_FOUNDER_ACCESS_CODE=dearher-founder
