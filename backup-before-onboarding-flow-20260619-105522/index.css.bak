@import "tailwindcss";

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
  --font-display: "Cormorant Garamond", Georgia, serif;

  --color-cream-100: #fff7f0;
  --color-lavender-200: #d8ceff;
  --color-rose-200: #f4b8c6;
}

:root {
  color-scheme: dark;
  background: #070a1a;
  font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --glass-strength: 0.075;
}

* {
  box-sizing: border-box;
}

html {
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  min-height: 100%;
  margin: 0;
  overflow-x: hidden;
  background: #070a1a;
}

button,
input,
textarea {
  font: inherit;
}

::selection {
  background: rgba(244, 184, 198, 0.35);
  color: #fff7f0;
}

@keyframes float-slow {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(42px, 28px, 0) scale(1.08);
  }
}

@keyframes float-delayed {
  0%,
  100% {
    transform: translate3d(0, 0, 0) scale(1);
  }
  50% {
    transform: translate3d(-38px, -22px, 0) scale(1.06);
  }
}

@keyframes particle-rise {
  0% {
    transform: translate3d(0, 30px, 0) scale(0.85);
  }
  50% {
    transform: translate3d(18px, -60px, 0) scale(1);
  }
  100% {
    transform: translate3d(-10px, -130px, 0) scale(0.75);
  }
}

@keyframes breathe {
  0%,
  100% {
    transform: scale(0.84);
  }
  36% {
    transform: scale(1.14);
  }
  45% {
    transform: scale(1.14);
  }
}

@keyframes breathe-glow {
  0%,
  100% {
    transform: scale(0.88);
    opacity: 0.62;
  }
  36% {
    transform: scale(1.16);
    opacity: 0.96;
  }
  45% {
    transform: scale(1.16);
    opacity: 0.96;
  }
}

@keyframes lamp-pulse {
  0%,
  100% {
    opacity: 0.48;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.82;
    transform: scale(1.06);
  }
}

.animate-float-slow {
  animation: float-slow 24s ease-in-out infinite;
}

.animate-float-delayed {
  animation: float-delayed 28s ease-in-out infinite;
}

.animate-particle-rise {
  animation: particle-rise 18s linear infinite alternate;
}

.animate-breathe {
  animation: breathe 11s ease-in-out infinite;
}

.animate-breathe-glow {
  animation: breathe-glow 11s ease-in-out infinite;
}

.animate-lamp-pulse {
  animation: lamp-pulse 8s ease-in-out infinite;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

.comfort-dock {
  padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
}

@media (max-width: 520px) {
  .comfort-dock {
    border-radius: 1.5rem;
  }
}

/* Dear Her v1.3 mobile app polish */
:root {
  font-synthesis: none;
  text-rendering: geometricPrecision;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html {
  min-height: 100%;
  background: #070a1a;
  scroll-behavior: smooth;
}

body {
  min-height: 100%;
  background:
    radial-gradient(circle at 15% 10%, rgba(185, 167, 255, 0.14), transparent 32rem),
    radial-gradient(circle at 85% 75%, rgba(217, 160, 111, 0.12), transparent 30rem),
    #070a1a;
  -webkit-tap-highlight-color: transparent;
  overscroll-behavior-y: none;
}

button,
a,
input,
textarea,
select {
  touch-action: manipulation;
}

button,
input,
textarea,
select {
  font: inherit;
}

::selection {
  background: rgba(244, 184, 198, 0.28);
  color: #fff7f0;
}

.skip-to-content {
  position: fixed;
  left: 1rem;
  top: 1rem;
  z-index: 100;
  transform: translateY(-150%);
  border-radius: 999px;
  background: #fff7f0;
  color: #070a1a;
  padding: 0.75rem 1rem;
  font-weight: 800;
  transition: transform 180ms ease;
}

.skip-to-content:focus {
  transform: translateY(0);
}

@supports (padding: max(0px)) {
  body {
    padding-left: env(safe-area-inset-left);
    padding-right: env(safe-area-inset-right);
  }
}

@media (max-width: 640px) {
  main {
    padding-bottom: 1.25rem;
  }

  input,
  textarea,
  select {
    font-size: 16px;
  }

  .comfort-dock {
    bottom: max(0.75rem, env(safe-area-inset-bottom));
    width: calc(100% - 1rem);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.001ms !important;
  }
}

/* Dear Her v1.8 production hardening */
img,
picture,
video,
canvas,
svg {
  max-width: 100%;
}

[aria-disabled="true"],
button:disabled {
  cursor: not-allowed;
}

input:disabled,
textarea:disabled,
button:disabled {
  opacity: 0.58;
}

@media (max-width: 420px) {
  .comfort-dock span {
    font-size: 0.72rem;
  }
}

/* Dear Her v2.3 landing polish */
@media (max-width: 640px) {
  .landing-hero-title {
    letter-spacing: -0.045em;
  }
}

::selection {
  background: rgba(255, 211, 226, 0.28);
  color: #fffaf3;
}
